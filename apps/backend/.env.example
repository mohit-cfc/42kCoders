DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dhundho
SARVAM_API_KEY=
GEMINI_API_KEY=
ALLOWED_ORIGINS=*

# Sarvam AI (optional overrides — defaults match docs.sarvam.ai)
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_TIMEOUT_S=15

# Gemini Flash fallback (optional overrides; GEMINI_API_KEY above enables it)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
